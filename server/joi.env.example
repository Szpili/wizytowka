# Copy to server/joi.env and load with: set -a; . server/joi.env; set +a; node server/joi-relay.mjs
PORT=8787
HOST=127.0.0.1
# Model server: Ollama (http://127.0.0.1:11434) or anything OpenAI-compatible (vLLM, llama.cpp, LM Studio).
# The API is detected; set LLM_API=ollama|openai to force it. LLM_KEY if the server wants a bearer token.
LLM_URL=http://127.0.0.1:11434
MODEL=qwen2.5:7b
LLM_API=auto
LLM_KEY=
# Origins allowed to talk to the relay (the card on GitHub Pages plus local previews)
ALLOWED_ORIGIN=https://szpili.github.io,http://127.0.0.1:8765,http://localhost:8765
# Where transcripts and leads.jsonl are written (e.g. ~/brain/inbox/joi)
TRANSCRIPT_DIR=./server/transcripts
# Set to 1 when the relay sits behind cloudflared or Tailscale Funnel
TRUST_PROXY=1
# Optional voice for the phone: an OpenAI-style TTS server (POST /v1/audio/speech) or a command.
# TTS_URL=http://127.0.0.1:8880   TTS_VOICE=af_heart
# TTS_CMD=piper --model ~/voices/pl_PL-gosia-medium.onnx --output_file {out}
TTS_URL=
TTS_VOICE=
TTS_CMD=
# Optional: a Telegram message for every lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
