# Copy to server/joi.env and load with: set -a; . server/joi.env; set +a; node server/joi-relay.mjs
PORT=8787
HOST=127.0.0.1
# Ollama with the model you want Joi to speak through
OLLAMA_URL=http://127.0.0.1:11434
MODEL=qwen2.5:7b
# Origins allowed to talk to the relay (the card on GitHub Pages plus local previews)
ALLOWED_ORIGIN=https://szpili.github.io,http://127.0.0.1:8765,http://localhost:8765
# Where transcripts and leads.jsonl are written (e.g. ~/brain/inbox/joi)
TRANSCRIPT_DIR=./server/transcripts
# Set to 1 when the relay sits behind cloudflared or Tailscale Funnel
TRUST_PROXY=1
# Optional: a Telegram message for every lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
